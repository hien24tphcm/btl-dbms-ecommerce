{
  "name": "ecommerce-dbms-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Vendor E-Commerce Platform (Next.js App Router + NestJS Modular API + MS SQL Server ECommerceDB)",
  "scripts": {
    "dev:api": "npm --prefix apps/api run start:dev",
    "dev:web": "npm --prefix apps/web run dev",
    "build:api": "npm --prefix apps/api run build",
    "build:web": "npm --prefix apps/web run build",
    "start:api": "npm --prefix apps/api run start",
    "start:web": "npm --prefix apps/web run start"
  }
}
